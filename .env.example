# ── спільне для всіх сервісів ────────────────────────────────
DATABASE_URL=                       # Railway підставляє через Reference
ADMIN_IDS=1293055247
JAMENDO_CLIENT_ID=                  # devportal.jamendo.com
JAMENDO_COMMERCIAL_APPROVED=false   # true only after written commercial-use approval
ENV=production

# ── сервіс bot ───────────────────────────────────────────────
BOT_TOKEN=
WEB_APP_URL=https://USERNAME.github.io/musiclsp
API_URL=https://bot-XXXX.up.railway.app
SOUNDCLOUD_CLIENT_ID=               # optional; requires explicit aggregation approval below
SOUNDCLOUD_CLIENT_SECRET=           # optional; keep private
SOUNDCLOUD_AGGREGATION_APPROVED=false # true only after explicit approval for aggregated streaming

# ── сервіс auth ──────────────────────────────────────────────
AUTH_BOT_TOKEN=
PANEL_URL=https://panel-XXXX.up.railway.app

# ── сервіс panel ─────────────────────────────────────────────
PANEL_SECRET=                       # python -c "import secrets;print(secrets.token_hex(32))"
PANEL_SESSION_HOURS=12

# ── сервіс worker ────────────────────────────────────────────
WORKER_INTERVAL=600
# Optional music integrations (credentials alone do not grant playback rights)
APPLE_MUSIC_DEVELOPER_TOKEN=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_APPROVED=false
SEVENDIGITAL_API_KEY=
